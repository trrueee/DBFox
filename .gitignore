# ============================================================
node_modules/
desktop/dist/
desktop/dist-tests/
desktop/dist-electron/
desktop/.electron-host-smoke-*/
desktop/.vite/

# ============================================================
# Rust / Tauri
# ============================================================
desktop/src-tauri/target/
desktop/src-tauri/gen/*
!desktop/src-tauri/gen/schemas/
desktop/src-tauri/.tauri/

# ============================================================
# Build outputs
# ============================================================
pyinstaller_dist/
pyinstaller_build/
*.spec

# ============================================================
# Test / coverage outputs
# ============================================================
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
desktop/coverage/
desktop/playwright-report/
desktop/test-results/
.tmp/
.cache/
output/
reports/
artifacts/*.json
artifacts/*_report*.md
artifacts/runtime-logs/
!artifacts/spider_*.json

# ============================================================
# Generated release evidence
# ============================================================
# Sidecar binaries, runtime manifests and release evidence are regenerated by
# build_sidecar.py and the release workflows; they are never long-term tracked.
desktop/src-tauri/binaries/

