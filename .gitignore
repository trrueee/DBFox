# ============================================================
# Secrets / environment
# ============================================================
.env
.env.*
!.env.example
*.local
*.local.*

# ============================================================
# Runtime state / databases
# ============================================================
engine/.secret_key
engine/.local_token
dbfox_local.db
dbfox_local.db.bak_*
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite.version
*.sqlite3
.dbfox_runtime/

# Test fixture databases must be tracked
!engine/tests/fixtures/**/*.sqlite

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
.build_venv/
*.log

# ============================================================
