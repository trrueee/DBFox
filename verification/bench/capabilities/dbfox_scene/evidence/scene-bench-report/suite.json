{
  "schema_version": "1.0",
  "suite_id": "capability.dbfox-scene.scripted",
  "suite_version": "1.0.0",
  "subject": {
    "kind": "capability",
    "components": [
      "dbfox.scene"
    ],
    "supporting_fixtures": [
      "scripted-provider",
      "migrated-metadata",
      "signed-package"
    ]
  },
  "execution": {
    "provider_modes": [
      "scripted"
    ],
    "default_repetitions": 1,
    "max_repetitions": 5
