{
  "schema_version": "1.0",
  "suite_id": "capability.dbfox_music.agent",
  "suite_version": "1.0.0",
  "description": "Agent-mediated piano composition and local revision tasks through the production RunLoop.",
  "subject": {"kind": "capability", "components": ["dbfox.music"], "supporting_fixtures": ["agent-core", "score-document-v1"]},
  "execution": {"provider_modes": ["real_provider"], "default_repetitions": 1, "max_repetitions": 5},
  "dataset": "cases.json",
  "metrics": [
    {"name": "task.success_rate", "direction": "higher_is_better", "unit": "ratio", "description": "Fraction of Music tasks satisfying deterministic score contracts."},
    {"name": "runtime.turns", "direction": "lower_is_better", "unit": "count", "description": "Production Agent Turns used."},
    {"name": "runtime.tool_calls", "direction": "lower_is_better", "unit": "count", "description": "Production Music tool invocations used."}
  ]
}
