{
  "name": "desktop",
  "private": true,
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@10.9.3",
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "build:visualization-vendor": "node scripts/build-visualization-vendor.mjs",
    "dev": "vite",
    "build": "npm run build:music-vendor && npm run build:visualization-vendor && tsc -b && node ./scripts/build-electron-host.mjs && node ./scripts/build.mjs && node ./scripts/check-production-token.mjs && node ./scripts/check-bundle-budget.mjs",
    "build:music-vendor": "node ./scripts/build-music-vendor.mjs",
    "build:electron-host": "tsc --project tsconfig.electron.json && node ./scripts/build-electron-host.mjs",
    "electron:dev": "npm run build:electron-host && node ./scripts/run-electron-dev.mjs",
    "electron:package": "npm run build && node ./scripts/prepare-electron-package.mjs && electron-builder --projectDir electron-app --config ../electron-builder.yml --publish never",
    "electron:package:dir": "npm run build && node ./scripts/prepare-electron-package.mjs && electron-builder --projectDir electron-app --config ../electron-builder.yml --dir --publish never",
    "electron:release": "python ../build_sidecar.py && npm run electron:package",
    "generate:api": "node ./scripts/generate-api.mjs",
    "check:bundle": "node ./scripts/check-bundle-budget.mjs",
    "lint": "eslint . && node ./scripts/check-design-contracts.mjs",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "test:sidecar": "node ./scripts/smoke-sidecar.mjs",
    "test:electron": "vitest run --config vitest.electron.config.ts --reporter=dot",
    "test:electron-packaged": "node ./scripts/smoke-packaged-electron.mjs",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@hookform/resolvers": "^5.9.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-toolbar": "1.1.19",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.10.2",
    "@zag-js/react": "1.43.3",
    "@zag-js/tree-view": "1.43.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "eventsource-parser": "^3.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.80.0",
    "react-json-view-lite": "2.5.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.29.0",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
