{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBFox",
  "version": "1.0.3",
  "identifier": "com.dbfox.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "python ../build_sidecar.py && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DBFox - AI 问数数据库客户端",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'self' dlc-asset:; script-src-attr 'none'; style-src 'self' dlc-asset:; style-src-attr 'none'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: https: dlc-asset:; font-src 'self' dlc-asset:",
      "devCsp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFRkJFNTZEOTIyMUMzOUYKUldTZnd5R1NiZVg3SHVxNjNIdkkwblp3eXdjcGN0Nzc0dXlRRGJOek8yRFd4N2FuNnMyS2QvU3gK",
      "endpoints": [
        "https://github.com/trrueee/DBFox/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "dbfox-icon.ico",
      "binaries/dbfox-engine-runtime-manifest.json": "dbfox-engine-runtime-manifest.json"
    },
    "externalBin": [
      "binaries/dbfox-engine"
    ],
    "windows": {
      "wix": {
        "template": "wix-template.wxs"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
